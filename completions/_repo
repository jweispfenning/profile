_repo() {
  local state

  if [ -z $REPO_LOCATIONS ]; then
    echo -e "please set REPO_LOCATIONS=(/path/to/repositories)"
    return
  fi

  _arguments '1:repos:($(_get_repos))'
}

function _get_repos {
  local opts=()
  for r in "${REPO_LOCATIONS[@]}"; do
    for d in "$(find $r -maxdepth 1 -mindepth 1 -type d -exec basename {} \;)"; do
      opts+=$d
    done
  done
  echo "$opts"
}

_repo "$@"

